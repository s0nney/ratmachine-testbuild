<html>
  <head>
    <meta charset="utf-8">
    <%= get_theme() %>
    <link rel="icon" href="/favicon.ico">
    <title>ratwires</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <%= redirector() %>
  </head>
  <body>
    <!-- No banner and no theme switcher: the whole mod area is chrome-free,
         so each panel sits alone in the middle of the page. Themes still
         apply, since get_theme() reads the same cookie; they just cannot be
         changed from here. -->
    <div class="mod_screen">
      <%= content %>
    </div>
  </body>
</html>
